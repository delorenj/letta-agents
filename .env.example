# Letta Connection Settings
# For self-hosted Letta (token and project are optional)
LETTA_BASE_URL=http://localhost:8283/v1
# LETTA_TOKEN=your_token_here
# LETTA_PROJECT=your_project_here

# For Letta Cloud (token and project are required)
# LETTA_BASE_URL=https://api.letta.com
# LETTA_TOKEN=your_letta_cloud_token
# LETTA_PROJECT=your_project_name

# Model Configuration
LETTA_LLM_MODEL=openai/gpt-4
LETTA_EMBEDDING_MODEL=openai/text-embedding-3-small

# MetaMCP Hub Configuration
METAMCP_HUB_URL=https://mcp.delo.sh/metamcp
# METAMCP_BEARER_TOKEN=your_hub_token_here

# RAG Configuration (Optional)
RAG_LOCAL_FOLDER=/path/to/your/project
RAG_FOLDER_NAME=default_rag

# LLM Provider Keys (for Letta agents)
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
